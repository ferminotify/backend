<%# One dead mailbox; same columns as list() 'morte' in data/email.js. Locals: r %>
<tr>
  <td><a class="user" href="utente?id=<%= r.id %>"><%= r.email %></a></td>
  <td><span class="badge <%= r.stato === 'Confermata' ? 'bad' : 'warn' %>"><%= r.stato %></span></td>
  <td><% if (r.altro === 'Nessun canale') { %><span class="badge bad"><%= r.altro %></span><% } else { %><%= r.altro %><% } %></td>
  <td><%= h.dateTime(new Date(r.dal)) %></td>
  <td class="wrap"><%= r.motivo || '–' %></td>
  <td class="num"><%= r.id %></td>
</tr>
